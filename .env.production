# Configuration du build de production. Les valeurs sont ici, en clair et
# versionnées : tout ce qui est préfixé `VITE_` est inliné dans le bundle par
# Vite, donc lisible par n'importe qui dans les devtools. Les passer par des
# variables de dépôt GitHub ne les protégeait pas, ça les dédoublait seulement.
# Un secret ne doit JAMAIS entrer dans ce fichier — il vit côté API, dans le
# `.env.local` du serveur.
VITE_API_URL=https://letmecountapi.lasoireefille.fr
VITE_APP_BASE_URL=https://letmecount.lasoireefille.fr

# OAuth. Le redirect_uri doit correspondre exactement à OAUTH_REDIRECT_URI côté
# API, et être déclaré chez Google comme chez Apple (Return URL du Services ID)
# et chez PocketID. Ces identifiants sont publics, ce ne sont pas des secrets.
VITE_GOOGLE_CLIENT_ID=528156589433-jj5st87tg25dg88uu42ct0hb4ggl4uvs.apps.googleusercontent.com
VITE_APPLE_SERVICES_ID=fr.lasoireefille.letmecount.web
VITE_POCKETID_BASE_URL=https://pocketid.appart.42p.ovh
VITE_POCKETID_CLIENT_ID=e9c5f27d-26ee-4375-9ade-1418af43ce35
VITE_OAUTH_REDIRECT_URI=https://letmecount.lasoireefille.fr/auth/callback

# Clé publique VAPID des notifications push. Publique, pas un secret : elle est
# aussi côté API (VAPID_PUBLIC_KEY) et doit correspondre exactement, sinon les
# abonnements créés ici sont inutilisables. C'est la même paire qu'en local :
# une seule paire pour tous les environnements, et jamais regénérée.
VITE_VAPID_PUBLIC_KEY=BLLNRdAFR1ZjQjEfwhZh0FvKy-brdwA0B1dCL-c_qiyJhwMTLJRUk3gkcphC0Ix8nclsbOECZ6BEFT5Z5EVhEG4
