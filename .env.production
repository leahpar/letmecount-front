VITE_API_URL=https://letmecountapi.lasoireefille.fr

# OAuth Google. Le redirect_uri doit correspondre exactement à OAUTH_REDIRECT_URI côté API.
# Le client_id (public, pas un secret) est à renseigner au moment du build.
VITE_GOOGLE_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=https://letmecount.lasoireefille.fr/auth/callback
