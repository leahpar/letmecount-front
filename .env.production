VITE_API_URL=https://letmecountapi.lasoireefille.fr

# OAuth. Le redirect_uri doit correspondre exactement à OAUTH_REDIRECT_URI côté
# API, et être déclaré chez Google comme chez Apple (Return URL du Services ID)
# et chez PocketID. Ces identifiants sont publics, ce ne sont pas des secrets.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_SERVICES_ID=
VITE_POCKETID_BASE_URL=
VITE_POCKETID_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=https://letmecount.lasoireefille.fr/auth/callback

# Clé publique VAPID des notifications push. Publique, pas un secret : elle est
# aussi côté API (VAPID_PUBLIC_KEY) et doit correspondre exactement, sinon les
# abonnements créés ici sont inutilisables.
VITE_VAPID_PUBLIC_KEY=
